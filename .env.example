# Copy to .env — none of these are required for the xlsx or export paths.
# OAuth desktop client downloaded from Google Cloud Console (see SETUP_GOOGLE_API.md)
SD_OAUTH_CLIENT=/home/bensonjt/.config/sheets_decomposer/credentials.json
# Cached user token (created automatically on first OAuth run)
SD_OAUTH_TOKEN=/home/bensonjt/.config/sheets_decomposer/token.json
# Service account key JSON (alternative to OAuth; share each sheet with the SA email)
SD_SERVICE_ACCOUNT=/home/bensonjt/.config/sheets_decomposer/service_account.json
