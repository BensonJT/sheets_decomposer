# Optional: interpreter for the ./sd wrapper (default: active conda env, .venv, or python on PATH)
SD_PYTHON=
# Copy to .env — none of these are required for the xlsx or export paths.
# OAuth desktop client downloaded from Google Cloud Console (see SETUP_GOOGLE_API.md)
SD_OAUTH_CLIENT=~/.config/sheets_decomposer/credentials.json
# Cached user token (created automatically on first OAuth run)
SD_OAUTH_TOKEN=~/.config/sheets_decomposer/token.json
# Service account key JSON (alternative to OAuth; share each sheet with the SA email)
SD_SERVICE_ACCOUNT=~/.config/sheets_decomposer/service_account.json
# Google Docs the Gem reads as knowledge; `sd push-docs out/<name>` or `sd ingest ... --push-docs` overwrites them
SD_GEM_CONTEXT_DOC=https://docs.google.com/document/d/<id>/edit
SD_REPORT_DOC=https://docs.google.com/document/d/<id>/edit
