#!/usr/bin/env bash
# Run the CLI. Uses the `sheets` conda env if present, else whatever `python` is active.
cd "$(dirname "$(readlink -f "$0")")" || exit 1
[ -f .env ] && SD_PYTHON=$(grep -E "^SD_PYTHON=" .env | cut -d= -f2-)
for PY in "${SD_PYTHON:-}" "$CONDA_PREFIX/bin/python" .venv/bin/python "$HOME/anaconda3/envs/sheets/bin/python" "$HOME/miniconda3/envs/sheets/bin/python"; do
  [ -n "$PY" ] && [ -x "$PY" ] && exec "$PY" -m sheets_decomposer.cli "$@"
done
exec python -m sheets_decomposer.cli "$@"
